# ==============================================================================
# Botmartz VORTEX Runtime Configuration Template
# Copy this file to .env and supply your credentials / local paths:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model Providers (Supply keys or leave blank to use local Ollama / llama.cpp)
# ------------------------------------------------------------------------------
# Google Gemini (Primary generation backbone)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI or OpenAI-Compatible endpoint (e.g. DeepSeek, Groq, Together)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 2. Local Accelerator & Serving Endpoints
# ------------------------------------------------------------------------------
# Local Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud

# Local llama.cpp server endpoint
LLAMACPP_BASE_URL=http://localhost:8081

# Distributed vLLM or SGLang cluster mode (Optional)
VLLM_BASE_URL=
VLLM_MODEL=
SGLANG_BASE_URL=

# Directory containing local GGUF / SafeTensors model weights
AI_VAULT_MODELS_DIR=./models

# ------------------------------------------------------------------------------
# 3. Storage & Network Settings
# ------------------------------------------------------------------------------
# Local database and index directory (defaults to ./data)
VORTEX_DATA_DIR=./data

# Port to serve FastAPI and the React 19 Studio
VORTEX_PORT=8420
